<body>

<header class="site-header">
  <div class="inner">
    <a class="brand" href="#top" aria-label="driftlab, back to top">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path class="mark-ack" d="M3 8 H21" stroke-width="2" stroke-linecap="round"/>
        <path class="mark-drift" d="M3 8 H8.5 C13 8 14 16.5 21 16.5" stroke-width="2" stroke-linecap="round"/>
