<main class="frame" id="top">

  <!-- ===== hero ===== -->
  <section class="band hero" aria-labelledby="hero-title">
    <a class="announce" href="#ledgers">
      <span class="tag">New</span>
      <span>Blnk fixed all 3 bugs driftlab found, within 4 days</span>
    </a>
    <h1 id="hero-title">Find the writes your system acknowledged, <span class="lost">then lost.</span></h1>
    <p class="lede">driftlab runs real clients and services through crashes, frozen brokers and network cuts. It records every send, acknowledgement and delivery, then checks the record. Anything lost, stored twice or delivered out of order shows up next to the fault that caused it.</p>
    <div class="actions">
      <a class="btn btn-primary" href="#findings">See the findings</a>
      <a class="btn btn-ghost" href="https://github.com/omkar619-dev/driftlab" target="_blank" rel="noopener">View on GitHub ↗</a>
      <div class="cmd">
        <span class="prompt">$</span>
        <code id="clone-cmd">git clone https://github.com/omkar619-dev/driftlab</code>
        <button class="copy" type="button" id="copy-clone" data-copy="clone-cmd" aria-label="Copy the clone command">Copy</button>
      </div>
    </div>

    <div class="panel" role="figure" aria-label="Four Kafka clients through five faults">
      <div class="panel-head">
        <div class="panel-title">kafka · 4 clients, 7 settings · 5 faults · one 3-broker cluster</div>
        <div class="legend" aria-hidden="true">
          <span><i class="k-lost"></i>lost or never stored</span>
          <span><i class="k-twice"></i>stored twice</span>
          <span><i class="k-clean"></i>clean</span>
        </div>
      </div>
      <div class="scroll">
        <table class="matrix">
          <thead>
            <tr>
              <th scope="col">Client and settings</th>
              <th scope="col">Leader crash, just after the topic is created</th>
              <th scope="col">Leader crash, during steady writing</th>
              <th scope="col">Both followers frozen</th>
              <th scope="col">One follower frozen</th>
              <th scope="col">One follower cut off</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row"><span class="client">franz-go v1.22.2</span><span class="setting">its defaults</span></th>
              <td><span class="clean">clean</span></td>
              <td><span class="clean">clean</span></td>
              <td><span class="clean">clean</span></td>
              <td><span class="clean">clean</span></td>
              <td><span class="clean">clean</span></td>
            </tr>
            <tr>
              <th scope="row"><span class="client">sarama v1.61.1</span><span class="setting">idempotent</span></th>
              <td><span class="clean">clean</span></td>
              <td><span class="clean">clean</span></td>
              <td><span class="clean">clean</span></td>
              <td><span class="clean">clean</span></td>
              <td><span class="clean">clean</span></td>
            </tr>
            <tr>
              <th scope="row"><span class="client">sarama v1.61.1</span><span class="setting">its defaults</span></th>
              <td><span class="chip lost">Lost acknowledged <b>5/5</b></span></td>
              <td><span class="chip lost">Lost acknowledged <b>1/3</b></span></td>
              <td><span class="clean">clean</span></td>
              <td><span class="clean">clean</span></td>
              <td><span class="clean">clean</span></td>
            </tr>
            <tr>
              <th scope="row"><span class="client">kafka-go v0.4.51</span><span class="setting">acks <code>all</code></span></th>
              <td><span class="clean">clean</span></td>
              <td><span class="clean">clean</span></td>
              <td><span class="chip twice">Stored a batch again <b>3/3</b></span></td>
              <td><span class="chip twice">Stored a batch again <b>3/3</b></span></td>
              <td><span class="chip twice">Stored a batch again <b>3/3</b></span></td>
            </tr>
            <tr>
              <th scope="row"><span class="client">kafka-go v0.4.51</span><span class="setting">its default, acks <code>none</code></span></th>
              <td><span class="chip lost">Sent, never stored <b>3/3</b></span></td>
              <td><span class="chip lost">Sent, never stored <b>3/3</b></span></td>
              <td><span class="clean">clean</span></td>
              <td><span class="clean">clean</span></td>
              <td><span class="clean">clean</span></td>
            </tr>
            <tr>
              <th scope="row"><span class="client">confluent-kafka-go v2.16.0</span><span class="setting">idempotent</span></th>
              <td><span class="clean">clean</span></td>
              <td><span class="clean">clean</span></td>
              <td><span class="clean">clean</span></td>
              <td><span class="clean">clean</span></td>
              <td><span class="clean">clean</span></td>
            </tr>
            <tr>
              <th scope="row"><span class="client">confluent-kafka-go v2.16.0</span><span class="setting">its defaults</span></th>
              <td><span class="chip twice">Stored a batch twice <b>1/3</b></span></td>
              <td><span class="chip twice">Stored a batch twice <b>2/3</b></span></td>
              <td><span class="clean">clean</span></td>
              <td><span class="clean">clean</span></td>
